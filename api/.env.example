# Copy to .env (never commit .env). Find these in Supabase: Project Settings > API / Database.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never put this in the mobile app or in git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT verification. Set the secret for HS256 projects (legacy JWT secret).
# Leave it EMPTY if your project uses asymmetric signing keys: the API then verifies against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json (ES256/RS256).
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
# JWT_ISSUER=            # defaults to <SUPABASE_URL>/auth/v1
JWT_LEEWAY_SECONDS=5

# Direct Postgres connection string (Settings > Database > Connection string, use the pooler URI).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_POOL_MAX=10

# Phone-only farmers get a synthetic login email: <phone>@<this domain>
PHONE_LOGIN_EMAIL_DOMAIN=phone.farmers.example
# Comma-separated browser origins. Needed only for the browser build, e.g. http://localhost:8081 (the native app does not need CORS)
CORS_ORIGINS=
